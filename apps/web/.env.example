# Copy to .env.local (git-ignored). Every VITE_* value ends up in the browser bundle: public values only.

# WalletConnect / Reown project ID (cloud.reown.com). Without it, WalletConnect (QR) wallets are off;
# injected EVM wallets and Bitcoin extension wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Default contract set: mezo-testnet (live, Skip oracle) or mezo-testnet-demo-sim (simulated price
# feed). A page can override it with ?deployment=<name>.
VITE_DEPLOYMENT=mezo-testnet
