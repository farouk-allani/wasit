# Copy to contracts/.env (git-ignored) and fill in. Forge loads it automatically when run from
# contracts/; the shell scripts in script/ load it themselves.
# Mezo TESTNET only (chain 31611). Never put a mainnet key or seed phrase here.

MEZO_TESTNET_RPC=https://rpc.test.mezo.org

# Testnet-only seed phrase. Accounts by derivation index (m/44'/60'/0'/0/i):
#   0 deployer, 1 buyer, 2 supplier, 3 agent, 4 inspector, 5 carrier, 6 arbiter
# Leave empty to sign with forge's own flags instead (--account, --private-key, --ledger).
WASIT_TESTNET_MNEMONIC=

# Optional: owner and fee recipient of the deployed contracts (both default to the deployer).
# WASIT_OWNER=0x...
# WASIT_FEE_RECIPIENT=0x...
